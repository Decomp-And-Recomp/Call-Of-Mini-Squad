<?xml version="1.0" encoding="utf-8"?>
<!--
How does this config work:
- Prices for weapon, skill and equipment upgrades. The game makes the full price tables from these numbers when it starts. If a value is missing, the game uses its own default.

How to change the value of an upgrade:
- Starting = the first price. Increase = how much it grows. IncreaseGrowth = how fast the growth speeds up.
- To add a breakthrough for a new star, copy a <Breakthrough> line and change star, crystal and teamLevel.
- rows in WeaponSkill = how many upgrades get a price. Make it bigger if you allow more upgrades.
-->
<!-- Upgrade price tables. Prices are generated from these formula values when the game starts. -->
<Upgrades>
<!-- 
Weapon and skill upgrade prices. You only set the first price and how fast it grows, and the game works out the rest.
- weaponStarting / skillStarting = price of the first upgrade.
- weaponIncrease / skillIncrease = how much the price goes up for the next upgrade.
- weaponIncreaseGrowth / skillIncreaseGrowth = how much bigger that price jump gets every upgrade.
- combatStarting = weapon power at the start. combatIncrease = how much power each upgrade adds.
- rows = how many upgrades get a price (30). Make it bigger if weapons or skills can be upgraded more than 30 times. 
-->
	<WeaponSkill rows="30" weaponStarting="1000" weaponIncrease="50" weaponIncreaseGrowth="20" skillStarting="300" skillIncrease="10" skillIncreaseGrowth="10" combatStarting="200" combatIncrease="70" />
	<!-- Weapon/skill breakthroughs, by the star being broken out of. crystal: tcrystal cost. teamLevel: team level required. The gold part of a breakthrough uses the level-up table price. Stars not listed use star 1's values. -->
	<Breakthroughs>
		<Breakthrough star="1" crystal="10" teamLevel="10" />
		<Breakthrough star="2" crystal="20" teamLevel="15" />
		<Breakthrough star="3" crystal="30" teamLevel="20" />
		<Breakthrough star="4" crystal="40" teamLevel="25" />
	</Breakthroughs>
	<!-- Helmet / armor / ornament prices. Starting: first price. Increase: how fast prices climb. Combat: starting combat rating (climbs at a quarter of Increase). -->
	<Equipment helmetStarting="300" helmetIncrease="15" helmetCombat="60" armorStarting="500" armorIncrease="25" armorCombat="100" ornamentStarting="200" ornamentIncrease="10" ornamentCombat="40">
		<!-- Per equipment slot (0-10, same for all three types). teamLevel: team level that makes it buyable. crystal: extra tcrystal cost to unlock, on top of the gold price. -->
		<Slot index="0" teamLevel="0" crystal="0" />
		<Slot index="1" teamLevel="8" crystal="0" />
		<Slot index="2" teamLevel="8" crystal="0" />
		<Slot index="3" teamLevel="16" crystal="10" />
		<Slot index="4" teamLevel="16" crystal="10" />
		<Slot index="5" teamLevel="16" crystal="10" />
		<Slot index="6" teamLevel="16" crystal="10" />
		<Slot index="7" teamLevel="24" crystal="20" />
		<Slot index="8" teamLevel="24" crystal="20" />
		<Slot index="9" teamLevel="24" crystal="20" />
		<Slot index="10" teamLevel="24" crystal="20" />
	</Equipment>
</Upgrades>
