<?xml version="1.0" encoding="utf-8"?>
<!-- Battle rewards and team experience curves. -->
<Rewards>
    <!-- Winning with 3 stars multiplies money and XP by threeStarMultiplier. firstThreeStarCrystals: crystals for the first 3-star clear of a stage. -->
    <Stars threeStarMultiplier="2" firstThreeStarCrystals="5" />

    <!-- Per-stage rewards (one row per stage). Row 0 = *Starting. Row n adds *StartIncreasing + *Increase * (n - 1) on top of the previous row. combat*: recommended team combat shown for the stage. -->
    <StageRewards rows="150" coinsStarting="1500" coinsStartIncreasing="10" coinsIncrease="5" xpStarting="510" xpStartIncreasing="280" xpIncrease="20" combatStarting="350" combatStartIncreasing="40" combatIncrease="20" />

    <!-- XP needed per team level. Row 0 = xpStarting. Row n adds xpStartIncreasing + xpIncrease * (n - 1), and xpIncrease grows by xpIncreaseGrowth every row. -->
    <TeamExperience rows="100" xpStarting="510" xpStartIncreasing="240" xpIncrease="240" xpIncreaseGrowth="30" />
</Rewards>
